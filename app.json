{
  "expo": {
    "name": "Network QoS Monitor",
    "slug": "network-qos-monitor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "networkqos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.qosmonitor.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Ubica tus mediciones de red en el mapa de cobertura.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Registra la cobertura de red mientras la app está en segundo plano.",
        "UIBackgroundModes": ["fetch"]
      }
    },
    "android": {
      "package": "com.qosmonitor.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_PHONE_STATE",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "POST_NOTIFICATIONS",
        "ACCESS_BACKGROUND_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ubica tus mediciones de red en el mapa de cobertura.",
          "locationAlwaysAndWhenInUsePermission": "Registra la cobertura de red mientras la app está en segundo plano."
        }
      ],
      [
        "react-native-background-fetch",
        {
          "minimumFetchInterval": 15
        }
      ],
      "react-native-maps"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
